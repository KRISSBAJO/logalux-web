# Copy to .env.local. Never commit .env.local.

# Go API base URL as seen from the Next.js server
LOGALUXE_API_URL=http://127.0.0.1:18080

# The admin console needs no secret here. Staff sign in with their own email and
# password, and the API issues the session. The first super admin comes from
# ADMIN_EMAIL and ADMIN_PASSWORD in logaluxe-be/.env.
